<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25098" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="tab-vc">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25073"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="collection view cell content view" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Tab Bar Controller-->
        <scene sceneID="tab-scene">
            <objects>
                <tabBarController storyboardIdentifier="MainTabBarController" id="tab-vc" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="tab-bar">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </tabBar>
                    <connections>
                        <segue destination="exn-nav" kind="relationship" relationship="viewControllers" id="tab-sg-1"/>
                        <segue destination="svn-nav" kind="relationship" relationship="viewControllers" id="tab-sg-2"/>
                        <segue destination="pfn-nav" kind="relationship" relationship="viewControllers" id="tab-sg-3"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tab-scene-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--สำรวจ-->
        <scene sceneID="exn-scene">
            <objects>
                <navigationController storyboardIdentifier="ExploreNavigationController" id="exn-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="สำรวจ" image="magnifyingglass" catalog="system" id="exn-nav-tbi"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="exn-nav-bar">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="exp-vc" kind="relationship" relationship="rootViewController" id="exn-nav-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="exn-scene-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--สำรวจ-->
        <scene sceneID="exp-scene">
            <objects>
                <viewController storyboardIdentifier="ExploreViewController" id="exp-vc" customClass="ExploreViewController" customModule="Nanglen_App" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="exp-view">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" keyboardDismissMode="onDrag" style="plain" separatorStyle="none" rowHeight="-1" estimatedRowHeight="170" sectionHeaderHeight="-1" estimatedSectionHeaderHeight="56" sectionFooterHeight="-1" estimatedSectionFooterHeight="-1" translatesAutoresizingMaskIntoConstraints="NO" id="exp-table">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </tableView>
                            <mapView hidden="YES" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" mapType="standard" translatesAutoresizingMaskIntoConstraints="NO" id="exp-map">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                            </mapView>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="exp-header">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="exp-title-row">
                                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Nanglen" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="exp-title">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <fontDescription key="fontDescription" style="UICTFontTextStyleLargeTitle"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                            <activityIndicatorView hidden="YES" opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="750" verticalHuggingPriority="750" hidesWhenStopped="YES" style="medium" translatesAutoresizingMaskIntoConstraints="NO" id="exp-loading">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                            </activityIndicatorView>
                                            <segmentedControl opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="top" segmentControlStyle="plain" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="exp-mode">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="100" id="c-014-nl"/>
                                                </constraints>
                                                <segments>
                                                    <segment title="" image="list.bullet" catalog="system"/>
                                                    <segment title="" image="map" catalog="system"/>
                                                </segments>
                                                <connections>
                                                    <action selector="viewModeChanged:" destination="exp-vc" eventType="valueChanged" id="a-001-nl"/>
                                                </connections>
                                            </segmentedControl>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="leading" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="exp-loc">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <buttonConfiguration key="configuration" style="plain" image="location" catalog="system" title="กรุงเทพฯ · แตะเพื่อใช้ตำแหน่งของคุณ"/>
                                                <connections>
                                                    <action selector="locationTapped:" destination="exp-vc" eventType="touchUpInside" id="a-002-nl"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="exp-title" firstAttribute="leading" secondItem="exp-title-row" secondAttribute="leading" constant="20" id="c-003-nl"/>
                                            <constraint firstItem="exp-title" firstAttribute="top" secondItem="exp-title-row" secondAttribute="top" constant="4" id="c-004-nl"/>
                                            <constraint firstItem="exp-loading" firstAttribute="leading" secondItem="exp-title" secondAttribute="trailing" constant="10" id="c-005-nl"/>
                                            <constraint firstItem="exp-loading" firstAttribute="centerY" secondItem="exp-title" secondAttribute="centerY" id="c-006-nl"/>
                                            <constraint firstAttribute="trailing" secondItem="exp-mode" secondAttribute="trailing" constant="20" id="c-007-nl"/>
                                            <constraint firstItem="exp-mode" firstAttribute="centerY" secondItem="exp-title" secondAttribute="centerY" id="c-008-nl"/>
                                            <constraint firstItem="exp-mode" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="exp-loading" secondAttribute="trailing" constant="8" id="c-009-nl"/>
                                            <constraint firstItem="exp-loc" firstAttribute="leading" secondItem="exp-title" secondAttribute="leading" id="c-010-nl"/>
                                            <constraint firstItem="exp-loc" firstAttribute="top" secondItem="exp-title" secondAttribute="bottom" constant="2" id="c-011-nl"/>
                                            <constraint firstAttribute="bottom" secondItem="exp-loc" secondAttribute="bottom" id="c-012-nl"/>
                                            <constraint firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="exp-loc" secondAttribute="trailing" constant="20" id="c-013-nl"/>
                                        </constraints>
                                    </view>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="exp-search-row">
                                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                        <subviews>
                                            <searchBar contentMode="redraw" searchBarStyle="minimal" placeholder="ค้นหาคาเฟ่ ห้องสมุด หรือที่ทำงาน" translatesAutoresizingMaskIntoConstraints="NO" id="exp-search">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <textInputTraits key="textInputTraits" returnKeyType="search"/>
                                            </searchBar>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="exp-filter">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="48" id="c-016-nl"/>
                                                    <constraint firstAttribute="height" constant="48" id="c-017-nl"/>
                                                </constraints>
                                                <buttonConfiguration key="configuration" style="plain" image="slider.horizontal.3" catalog="system" title=""/>
                                                <connections>
                                                    <action selector="filterTapped:" destination="exp-vc" eventType="touchUpInside" id="a-015-nl"/>
                                                </connections>
                                            </button>
                                            <label hidden="YES" opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="1" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="exp-badge">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="18" id="c-018-nl"/>
                                                    <constraint firstAttribute="height" constant="18" id="c-019-nl"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" style="UICTFontTextStyleCaption2"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                        </subviews>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="exp-search" firstAttribute="leading" secondItem="exp-search-row" secondAttribute="leading" constant="12" id="c-020-nl"/>
                                            <constraint firstItem="exp-search" firstAttribute="top" secondItem="exp-search-row" secondAttribute="top" id="c-021-nl"/>
                                            <constraint firstAttribute="bottom" secondItem="exp-search" secondAttribute="bottom" id="c-022-nl"/>
                                            <constraint firstItem="exp-filter" firstAttribute="leading" secondItem="exp-search" secondAttribute="trailing" constant="4" id="c-023-nl"/>
                                            <constraint firstAttribute="trailing" secondItem="exp-filter" secondAttribute="trailing" constant="20" id="c-024-nl"/>
                                            <constraint firstItem="exp-filter" firstAttribute="centerY" secondItem="exp-search" secondAttribute="centerY" id="c-025-nl"/>
                                            <constraint firstItem="exp-badge" firstAttribute="centerX" secondItem="exp-filter" secondAttribute="trailing" constant="-4" id="c-026-nl"/>
                                            <constraint firstItem="exp-badge" firstAttribute="centerY" secondItem="exp-filter" secondAttribute="top" constant="4" id="c-027-nl"/>
                                        </constraints>
                                    </view>
                                    <collectionView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" showsHorizontalScrollIndicator="NO" showsVerticalScrollIndicator="NO" dataMode="prototypes" translatesAutoresizingMaskIntoConstraints="NO" id="exp-chips">
                                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="40" id="c-034-nl"/>
                                        </constraints>
                                        <collectionViewFlowLayout key="collectionViewLayout" scrollDirection="horizontal" automaticEstimatedItemSize="YES" minimumLineSpacing="8" minimumInteritemSpacing="8" id="exp-chips-layout">
                                            <size key="itemSize" width="100" height="36"/>
                                            <size key="headerReferenceSize" width="0.0" height="0.0"/>
                                            <size key="footerReferenceSize" width="0.0" height="0.0"/>
                                            <inset key="sectionInset" minX="20" minY="2" maxX="20" maxY="2"/>
                                        </collectionViewFlowLayout>
                                        <cells>
                                            <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" reuseIdentifier="CategoryChipCell" id="chip-cell" customClass="CategoryChipCell" customModule="Nanglen_App" customModuleProvider="target">
                                                <rect key="frame" x="20" y="2" width="100" height="36"/>
                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                                <collectionViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" insetsLayoutMarginsFromSafeArea="NO" id="chip-content">
                                                    <rect key="frame" x="0.0" y="0.0" width="100" height="36"/>
                                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                                    <subviews>
                                                        <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="chip-stack">
                                                            <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                            <subviews>
                                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="sparkles" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="chip-icon">
                                                                    <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                                </imageView>
                                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="ทั้งหมด" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="chip-label">
                                                                    <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                                    <fontDescription key="fontDescription" style="UICTFontTextStyleSubhead"/>
                                                                    <nil key="highlightedColor"/>
                                                                </label>
                                                            </subviews>
                                                        </stackView>
                                                    </subviews>
                                                    <constraints>
                                                        <constraint firstItem="chip-stack" firstAttribute="leading" secondItem="chip-content" secondAttribute="leading" constant="14" id="c-028-nl"/>
                                                        <constraint firstAttribute="trailing" secondItem="chip-stack" secondAttribute="trailing" constant="14" id="c-029-nl"/>
                                                        <constraint firstItem="chip-stack" firstAttribute="top" secondItem="chip-content" secondAttribute="top" constant="8" id="c-030-nl"/>
                                                        <constraint firstAttribute="bottom" secondItem="chip-stack" secondAttribute="bottom" constant="8" id="c-031-nl"/>
                                                    </constraints>
                                                </collectionViewCellContentView>
                                                <connections>
                                                    <outlet property="iconImageView" destination="chip-icon" id="o-032-nl"/>
                                                    <outlet property="titleLabel" destination="chip-label" id="o-033-nl"/>
                                                </connections>
                                            </collectionViewCell>
                                        </cells>
                                    </collectionView>
                                    <view hidden="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="exp-banner">
                                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                        <subviews>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="exp-banner-card">
                                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                <subviews>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="เชื่อมต่อ Apple Maps ไม่ได้" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="exp-banner-label">
                                                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                                        <fontDescription key="fontDescription" style="UICTFontTextStyleFootnote"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                </subviews>
                                                <color key="backgroundColor" name="CardBackground"/>
                                                <constraints>
                                                    <constraint firstItem="exp-banner-label" firstAttribute="top" secondItem="exp-banner-card" secondAttribute="top" constant="10" id="c-035-nl"/>
                                                    <constraint firstItem="exp-banner-label" firstAttribute="leading" secondItem="exp-banner-card" secondAttribute="leading" constant="14" id="c-036-nl"/>
                                                    <constraint firstAttribute="trailing" secondItem="exp-banner-label" secondAttribute="trailing" constant="14" id="c-037-nl"/>
                                                    <constraint firstAttribute="bottom" secondItem="exp-banner-label" secondAttribute="bottom" constant="10" id="c-038-nl"/>
                                                </constraints>
                                            </view>
                                        </subviews>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="exp-banner-card" firstAttribute="top" secondItem="exp-banner" secondAttribute="top" id="c-039-nl"/>
                                            <constraint firstItem="exp-banner-card" firstAttribute="leading" secondItem="exp-banner" secondAttribute="leading" constant="20" id="c-040-nl"/>
                                            <constraint firstAttribute="trailing" secondItem="exp-banner-card" secondAttribute="trailing" constant="20" id="c-041-nl"/>
                                            <constraint firstAttribute="bottom" secondItem="exp-banner-card" secondAttribute="bottom" id="c-042-nl"/>
                                        </constraints>
                                    </view>
                                </subviews>
                            </stackView>
                            <button hidden="YES" opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="exp-area">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                <buttonConfiguration key="configuration" style="plain" image="arrow.clockwise" catalog="system" title="ค้นหาบริเวณนี้"/>
                                <connections>
                                    <action selector="searchAreaTapped:" destination="exp-vc" eventType="touchUpInside" id="a-043-nl"/>
                                </connections>
                            </button>
                            <button hidden="YES" opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="exp-locate">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="50" id="c-045-nl"/>
                                    <constraint firstAttribute="height" constant="50" id="c-046-nl"/>
                                </constraints>
                                <buttonConfiguration key="configuration" style="plain" image="location.fill" catalog="system" title=""/>
                                <connections>
                                    <action selector="locateTapped:" destination="exp-vc" eventType="touchUpInside" id="a-044-nl"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="exp-safe"/>
                        <color key="backgroundColor" name="AppBackground"/>
                        <constraints>
                            <constraint firstItem="exp-header" firstAttribute="top" secondItem="exp-safe" secondAttribute="top" constant="4" id="c-047-nl"/>
                            <constraint firstItem="exp-header" firstAttribute="leading" secondItem="exp-view" secondAttribute="leading" id="c-048-nl"/>
                            <constraint firstAttribute="trailing" secondItem="exp-header" secondAttribute="trailing" id="c-049-nl"/>
                            <constraint firstItem="exp-table" firstAttribute="top" secondItem="exp-header" secondAttribute="bottom" constant="6" id="c-050-nl"/>
                            <constraint firstItem="exp-table" firstAttribute="leading" secondItem="exp-view" secondAttribute="leading" id="c-051-nl"/>
                            <constraint firstAttribute="trailing" secondItem="exp-table" secondAttribute="trailing" id="c-052-nl"/>
                            <constraint firstAttribute="bottom" secondItem="exp-table" secondAttribute="bottom" id="c-053-nl"/>
                            <constraint firstItem="exp-map" firstAttribute="top" secondItem="exp-header" secondAttribute="bottom" constant="6" id="c-054-nl"/>
                            <constraint firstItem="exp-map" firstAttribute="leading" secondItem="exp-view" secondAttribute="leading" id="c-055-nl"/>
                            <constraint firstAttribute="trailing" secondItem="exp-map" secondAttribute="trailing" id="c-056-nl"/>
                            <constraint firstAttribute="bottom" secondItem="exp-map" secondAttribute="bottom" id="c-057-nl"/>
                            <constraint firstItem="exp-area" firstAttribute="top" secondItem="exp-map" secondAttribute="top" constant="12" id="c-058-nl"/>
                            <constraint firstItem="exp-area" firstAttribute="centerX" secondItem="exp-map" secondAttribute="centerX" id="c-059-nl"/>
                            <constraint firstItem="exp-safe" firstAttribute="trailing" secondItem="exp-locate" secondAttribute="trailing" constant="16" id="c-060-nl"/>
                            <constraint firstItem="exp-safe" firstAttribute="bottom" secondItem="exp-locate" secondAttribute="bottom" constant="16" id="c-061-nl"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="สำรวจ" id="exp-navitem"/>
                    <connections>
                        <outlet property="bannerCardView" destination="exp-banner-card" id="o-071-nl"/>
                        <outlet property="bannerLabel" destination="exp-banner-label" id="o-072-nl"/>
                        <outlet property="bannerView" destination="exp-banner" id="o-070-nl"/>
                        <outlet property="categoryCollectionView" destination="exp-chips" id="o-069-nl"/>
                        <outlet property="filterBadgeLabel" destination="exp-badge" id="o-068-nl"/>
                        <outlet property="filterButton" destination="exp-filter" id="o-067-nl"/>
                        <outlet property="loadingIndicator" destination="exp-loading" id="o-063-nl"/>
                        <outlet property="locateButton" destination="exp-locate" id="o-076-nl"/>
                        <outlet property="locationButton" destination="exp-loc" id="o-065-nl"/>
                        <outlet property="mapView" destination="exp-map" id="o-074-nl"/>
                        <outlet property="searchAreaButton" destination="exp-area" id="o-075-nl"/>
                        <outlet property="searchBar" destination="exp-search" id="o-066-nl"/>
                        <outlet property="tableView" destination="exp-table" id="o-073-nl"/>
                        <outlet property="titleLabel" destination="exp-title" id="o-062-nl"/>
                        <outlet property="viewModeControl" destination="exp-mode" id="o-064-nl"/>
                        <segue destination="det-vc" kind="show" identifier="showVenueDetail" id="exp-sg-detail"/><segue destination="add-nav" kind="presentation" identifier="presentAddPlace" id="exp-sg-add"/>
                        <segue destination="fln-nav" kind="presentation" identifier="presentFilter" id="exp-sg-filter"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="exp-scene-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--บันทึกไว้-->
        <scene sceneID="svn-scene">
            <objects>
                <navigationController storyboardIdentifier="SavedNavigationController" id="svn-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="บันทึกไว้" image="heart" catalog="system" selectedImage="heart.fill" id="svn-nav-tbi"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" largeTitles="YES" id="svn-nav-bar">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="sav-vc" kind="relationship" relationship="rootViewController" id="svn-nav-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="svn-scene-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <!--บันทึกไว้-->
        <scene sceneID="sav-scene">
            <objects>
                <viewController storyboardIdentifier="SavedViewController" id="sav-vc" customClass="SavedViewController" customModule="Nanglen_App" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="sav-view">
                        <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" style="plain" separatorStyle="none" rowHeight="-1" estimatedRowHeight="170" sectionHeaderHeight="-1" estimatedSectionHeaderHeight="-1" sectionFooterHeight="-1" estimatedSectionFooterHeight="-1" translatesAutoresizingMaskIntoConstraints="NO" id="sav-table">
                                <rect key="frame" x="0.0" y="0.0" width="1000" height="1000"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </tableView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="sav-safe"/>
                        <color key="backgroundColor" name="AppBackground"/>
                        <constraints>
